---
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";

interface Props { title?: string; description?: string; active?: string; }
const {
    title = "Constra | Building Construction Company",
    description = "Constra designs and builds residential, commercial and industrial projects on time, on budget and built to last.",
    active = "",
} = Astro.props;
---
<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <title>{title}</title>
        <meta content="width=device-width, initial-scale=1.0" name="viewport" />
        <meta content="construction, building, design build, project management" name="keywords" />
        <meta content={description} name="description" />

        <!-- Google Web Fonts -->
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400..900;1,400..900&family=Roboto:wght@400;500;700&display=swap" rel="stylesheet" />

        <!-- Icon Font Stylesheet -->
        <link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.15.4/css/all.css" />
        <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.4.1/font/bootstrap-icons.css" rel="stylesheet" />

        <!-- Libraries Stylesheet -->
        <link href="lib/animate/animate.min.css" rel="stylesheet" />

        <!-- Customized Bootstrap Stylesheet -->
        <link href="css/bootstrap.min.css" rel="stylesheet" />

        <!-- Template Stylesheet -->
        <link href="css/style.css" rel="stylesheet" />

        <!-- Modern motion layer -->
        <link href="css/modern.css" rel="stylesheet" />
    </head>

    <body>
        <!-- Spinner (its contents are drawn by js/modern.js) -->
        <div id="spinner" class="show bg-white position-fixed translate-middle w-100 vh-100 top-50 start-50 d-flex align-items-center justify-content-center">
            <div class="spinner-border text-primary" style="width: 3rem; height: 3rem;" role="status">
                <span class="sr-only">Loading...</span>
            </div>
        </div>

        <Navbar active={active} />

        <slot />

        <Footer />

        <!-- JavaScript Libraries -->
        <script is:inline src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.4/jquery.min.js"></script>
        <script is:inline src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0/dist/js/bootstrap.bundle.min.js"></script>
        <script is:inline src="lib/wow/wow.min.js"></script>
        <script is:inline src="lib/easing/easing.min.js"></script>
        <script is:inline src="lib/waypoints/waypoints.min.js"></script>

        <!-- Template + motion JavaScript -->
        <script is:inline src="js/main.js"></script>
        <script is:inline src="js/modern.js"></script>
    </body>
</html>
